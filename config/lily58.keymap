#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        bt_clr_shift: bt_clr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&bt BT_CLR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_nxt_shift: bt_nxt_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&bt BT_NXT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | CTRL  |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | Code |  SPACE |  | ENTER |  Nav | BSPC  | DEL   |

            display-name = "Base";
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB           &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LEFT_SHIFT    &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                  &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp BSPC  &kp DEL
            >;
        };


        code_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |       |  `  |  ~  |  #   |  $   |  %   |                   |  ^   |   @   |   |   |  \   |       |  F12  |
            // |       |  !  |  &  |  *   |  :   |  =   |                   |  _   |   (   |   {   |  [   |   <   |   +   |
            // |       |C(Z) |C(X) |C(C)  |C(V)  |      |        |  |       |      |   )   |   }   |  ]   |   >   |   -   |
            //                     |      |      |      |        |  |       |      | RGUI  | RALT  |
            
            compatible = "zmk,keymap";
            display-name = "Code";
            bindings = <
&trans  &kp F1     &kp F2     &kp F3     &kp F4      &kp F5                        &kp F6     &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans  &kp GRAVE  &kp TILDE  &kp HASH   &kp DOLLAR  &kp PRCNT                     &kp CARET  &kp AT    &kp PIPE  &kp BSLH  &trans    &kp F12
&trans  &kp EXCL   &kp AMPS   &kp STAR   &kp COLON   &kp EQUAL                     &kp UNDER  &kp LPAR  &kp LBRC  &kp LBKT  &kp LT    &kp PLUS
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &trans     &trans    &trans   &trans     &kp RPAR  &kp RBRC  &kp RBKT  &kp GT    &kp MINUS
                              &trans     &trans      &trans     &trans    &trans   &trans     &kp RGUI  &kp RALT
            >;
        };

        nav_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |S:BTCLR|     |     |      |      |      |                   |      |       |       |      |       |       |
            // |S:BTNXT|MUTE |VOL- |VOL+  |BRI-  |BRI+  |                   | HOME | PgDn  | PgUp  | END  |       | PrtSc |
            // |       |     | PREV| PLAY | NEXT |      |                   |  <-  |   v   |   ^   |  ->  |       |  INS  |
            // |       |     |     |      |      |      |   =    |  |       |      |       |       |      |   \   |       |
            //                     | DEL  | BSPC |      |        |  |       |      |       |       |
            // S: = requires Shift to activate (mod-morph)
            
            compatible = "zmk,keymap";
            display-name = "Nav";
            bindings = <
&bt_clr_shift  &trans      &trans        &trans        &trans        &trans                             &trans          &trans          &trans        &trans           &trans          &trans
&bt_nxt_shift  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DEC &kp C_BRI_INC                      &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none           &kp PRINTSCREEN
&trans         &none       &kp C_PREV    &kp C_PP      &kp C_NEXT    &none                              &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none           &kp INSERT
&trans         &none       &none         &none         &none         &none         &kp EQUAL    &none   &none           &none           &none         &none            &none           &trans
                                         &kp DEL       &kp BACKSPACE &trans        &trans       &trans  &trans          &trans          &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
